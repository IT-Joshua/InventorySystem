@page "/company"
@using System.Net.Http.Json
@using Frontend.Client
@using Frontend.Models;

@inject CompanyClient CompanyClient

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <MudItem>
        <div class="alert alert-warning">@_errorMessage</div>
    </MudItem>
}
else
{

    <MudDataGrid @ref="_companiesGrid" T="CompanyDetails" Items="@_companies" ReadOnly="false"
        EditMode="@DataGridEditMode.Form" StartedEditingItem="@StartedEditingItem"
        CanceledEditingItem="@CanceledEditingItem" CommittedItemChanges="@CommittedItemChanges" Bordered="true" Dense="true"
        EditTrigger="DataGridEditTrigger.Manual" 
        SortMode="SortMode.Multiple" Filterable="true" Hideable="true">
        <ToolBarContent>
            <MudText Typo="Typo.h6">Companies</MudText>
            <MudSpacer />
            <MudButtonGroup Class="ma-0 pa-0" Color="Color.Success" Variant="Variant.Filled">
                <MudButton OnClick="NewItemAsync">
                    Add New Item
                </MudButton>
            </MudButtonGroup>
        </ToolBarContent>
        <Columns>
            <PropertyColumn Property="x => x.Company_Id" Title="ID" Hidden="true" Editable="false"/>
            <PropertyColumn Property="x => x.Company_Name" Title="Company Name"/>
            <PropertyColumn Property="x => x.Prefix"/>
            <PropertyColumn Property="x => x.Transaction_Prefix" Title="Trasanction Prefix"/>
            <PropertyColumn Property="x => x.Transaction_Series" Title="Transaction Series"/>
            @*<PropertyColumn Property="x => x.Position">
            <EditTemplate>
                <MudSelect @bind-Value="context.Item.Position" Required RequiredError="You must select a Position!!!" Margin="@Margin.Dense">
                    <MudSelectItem Value="0">zero</MudSelectItem>
                    <MudSelectItem Value="1">one</MudSelectItem>
                    <MudSelectItem Value="17">seventeen</MudSelectItem>
                </MudSelect>
            </EditTemplate>
        </PropertyColumn> *@
            <PropertyColumn Property="x => x.Transaction_Format" Title="Transaction Format" />
            <TemplateColumn Hidden="false" CellClass="d-flex justify-between">
                <CellTemplate>
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit"
                        OnClick="@context.Actions.StartEditingItemAsync" />
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete"
                        OnClick="@(() => DeleteItem(context.Item))" />
                </CellTemplate>
                <EditTemplate>
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Edit"
                        OnClick="@context.Actions.StartEditingItemAsync" />
                    <MudIconButton Size="@Size.Small" Icon="@Icons.Material.Outlined.Delete"
                        OnClick="@(() => DeleteItem(context.Item))" />
                </EditTemplate>
            </TemplateColumn>
        </Columns>
    </MudDataGrid>
}

@code {
    private IEnumerable<CompanyDetails> _companiesMasterList = [];
    private List<CompanyDetails> _companies = [];
    private List<string> _events = new();
    private MudDataGrid<CompanyDetails> _companiesGrid = default!;
    private string? _errorMessage;
    
    protected override async Task OnInitializedAsync()
    {
        try
        {
            _companiesMasterList = await CompanyClient.GetCompaniesAsync();
            _companies = _companiesMasterList.Take(4).ToList();
        }
        catch (HttpRequestException ex)
        {
            _errorMessage = "Unable to load companies.";

            // Detect unauthorized access (403 or 401)
            if (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
                _errorMessage = "You don't have permission to view companies.";
            else if (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                _errorMessage = "Your session has expired. Please login again.";

            // Optional: Show empty list to avoid UI errors
            _companies = new List<CompanyDetails>();
        }
    }

    private async Task NewItemAsync()
    {
        CompanyDetails? newCompany = new CompanyDetails(){
            Company_Id = "0",
            Company_Name = string.Empty,
            Prefix = string.Empty,
            Transaction_Prefix = string.Empty,
            Transaction_Series = 0,
            Transaction_Format = string.Empty
        };
        await _companiesGrid.SetEditingItemAsync(newCompany);
    }

    private void DeleteItem(CompanyDetails item)
    {
        _companies.Remove(item);
    }

    // events
    private void StartedEditingItem(CompanyDetails item)
    {
        _events.Insert(0, $"Event = StartedEditingItem, Data = {System.Text.Json.JsonSerializer.Serialize(item)}");
    }

    private void CanceledEditingItem(CompanyDetails item)
    {
        // update code for backing data here if needed
        _events.Insert(0, $"Event = CanceledEditingItem, Data = {System.Text.Json.JsonSerializer.Serialize(item)}");
    }

    private void CommittedItemChanges(CompanyDetails item)
    {
        // update code for the backing data here
        if (item.Company_Id == "0") // new item
        {
            bool cellMode = _companies.Remove(item); // for cell mode
            @* var maxMaster = _companiesMasterList.Any() ? _companiesMasterList.Max(x => x.Number) : 0; *@
            @* var maxElements = _companies.Any() ? _companies.Max(x => x.Company_Id) : 0;
            item.Number = Math.Max(maxMaster, maxElements) + 1;           *@
            _companies.Add(item);          
        }   
        _events.Insert(0, $"Event = CommittedItemChanges, Data = {System.Text.Json.JsonSerializer.Serialize(item)}");
    }
}