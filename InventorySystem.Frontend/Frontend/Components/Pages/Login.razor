@page "/"
@page "/login"
@* @layout LoginLayout *@

@using Frontend.Components.Models
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using Frontend.Components.Client



@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject LoginClients loginClient
<PageTitle>AITS : Asset & Inventory Tracking System</PageTitle>





<div class="login-wrapper">
    <div class="login-box shadow-lg" style="height:@(showCreateAccount ? "676px" : "520px")">
        <!-- Left image section -->
        <div class="login-image">
            <div class="image-slider">
                @foreach (var img in images)
                {
                    <div class="slide @(img == images[currentImageIndex] ? "active" : "")"
                        style="background-image: url('@img')">
                    </div>
                }
            </div>
        </div>
        <!-- Right form section -->
        <div class="login-form-area">
            @if (showCreateAccount)
            {
                <h3 class="text-center mb-4">Create Account</h3>


                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="alert-container">
                        <MudAlert Severity="@MessageSeverity" Variant="Variant.Filled">
                            @Message
                        </MudAlert>
                    </div>

                }


                <EditForm Model="@CreateAccountCredentialsModel" OnValidSubmit="HandleCreateAccount">
                    <DataAnnotationsValidator />
                    <ValidationSummary />
                    <div class="row mb-3">
                        <div class="col">
                            <label for="firstName" class="form-label">First Name:</label>
                            <InputText class="form-control" placeholder="First Name"
                                @bind-Value="CreateAccountCredentialsModel.FirstName" />
                        </div>
                        <div class="col">
                            <label for="lastName" class="form-label">Last Name:</label>
                            <InputText class="form-control" placeholder="Last Name"
                                @bind-Value="CreateAccountCredentialsModel.LastName" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="lastName" class="form-label">Username:</label>
                        <InputText class="form-control" placeholder="Username"
                            @bind-Value="CreateAccountCredentialsModel.Username" />
                    </div>

                    <div class="mb-3">
                        <label for="lastName" class="form-label">Email:</label>
                        <InputText class="form-control" type="email" placeholder="Email"
                            @bind-Value="CreateAccountCredentialsModel.Email" />
                    </div>

                    <div class="mb-3">
                        <label for="lastName" class="form-label">Password:</label>
                        <InputText class="form-control" type="password" placeholder="Password"
                            @bind-Value="CreateAccountCredentialsModel.Password" />
                    </div>

                    <div class="mb-3">
                        <label for="lastName" class="form-label">Confirm Password:</label>
                        <InputText class="form-control" type="password" placeholder="Confirm Password"
                            @bind-Value="CreateAccountCredentialsModel.ConfirmPassword" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3">Create Account</button>
                    <button type="button" class="btn btn-outline-secondary w-100"
                        @onclick="() => showCreateAccount = false">Back to Login</button>
                </EditForm>
            }
            else
            {
                <h3 class="text-center mb-4">Login</h3>

                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="alert-container">
                        <MudAlert Severity="@MessageSeverity" Variant="Variant.Filled">
                            @Message
                        </MudAlert>
                    </div>

                }


                <EditForm Model="@loginCredentials" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="mb-3">
                        <label for="username" class="form-label">Username/Email:</label>
                        <InputText class="form-control" placeholder="Username" @bind-Value="loginCredentials.Username" />
                    </div>

                    <div class="mb-3 input-password-wrapper">
                        <label for="password" class="form-label">Password:</label>
                        <InputText class="form-control" type="@(showPassword ? "text" : "password")" placeholder="Password"
                            @bind-Value="loginCredentials.Password" />

                        <button type="button" class="toggle-password" @onclick="() => showPassword = !showPassword">
                            <i class="fa-solid @(showPassword ? "fa-eye" : "fa-eye-slash")"></i>
                        </button>
                        @* <InputText class="form-control" type="password" placeholder="Password"
                                @bind-Value="loginCredentials.Password" /> *@
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="loginCredentials.RememberMe" />
                            <label class="form-check-label">Remember Me</label>
                        </div>
                        <a href="" class="forgot-password-link">Forgot Password?</a>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-3">Login</button>

                    <div class="d-flex justify-content-between">
                        <button type="button" class="btn btn-outline-primary w-100 me-2"
                            @onclick="() => showCreateAccount = true">
                            <i class="bi bi-google"></i> Create an Account
                        </button>
                    </div>
                </EditForm>
            }
        </div>
    </div>
</div>





@code {
    private bool showPassword = false;
    private LoginCredentialsModel loginCredentials = new();

    private List<LogInModels>? loginModels;

    private CreateAccountModels CreateAccountModels = new();
    private CreateAccountCredentialsModel CreateAccountCredentialsModel = new();
    private string Message = "";
    private Severity MessageSeverity = Severity.Error;


    private bool showCreateAccount = false;
    private int currentImageIndex = 0;
    private List<string> images = new()
{
"/Images/ContainerLeftImage1.jpg",
"/Images/ContainerLeftImage2.jpg"
};

    private async Task ShowMessage(string text, Severity severity = Severity.Error, int durationSeconds = 5)
    {
        Message = text;
        MessageSeverity = severity;
        StateHasChanged();

        await Task.Delay(durationSeconds * 1000);

        Message = "";
        StateHasChanged();
    }

    protected override void OnInitialized()
    {

        loginCredentials.RememberMe = true;
        var timer = new System.Timers.Timer(5000);
        timer.Elapsed += (s, e) =>
        {
            currentImageIndex = (currentImageIndex + 1) % images.Count;
            InvokeAsync(StateHasChanged);
        };
        timer.Start();
    }


    private async Task HandleLogin()
    {

        loginModels = await loginClient.GetUsersAsync(loginCredentials.Username);


        var user = loginModels.FirstOrDefault();

        if (user != null && loginCredentials.Password == user.Password)
        {
            Console.WriteLine(user.Username);

            if (loginCredentials.RememberMe)
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "LoggedInUser", loginCredentials.Username);

            }
            else
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", "LoggedInUser", loginCredentials.Username);

            }




            NavigationManager.NavigateTo("/home", forceLoad: true);
        }
        else
        {
            await ShowMessage("Invalid username or password", Severity.Error);
        }



    }


    private async Task HandleCreateAccount()
    {
        if (CreateAccountCredentialsModel.Password != CreateAccountCredentialsModel.ConfirmPassword)
        {
            await ShowMessage("Passwords do not match!", Severity.Error);
            StateHasChanged();
            return;
        }
        var usernameCheck = await loginClient.GetUsersAsync(CreateAccountCredentialsModel.Username);
        var emailCheck = await loginClient.GetUsersAsync(CreateAccountCredentialsModel.Email);

        if ((usernameCheck != null && usernameCheck.Count > 0) ||
        (emailCheck != null && emailCheck.Count > 0))
        {
            await ShowMessage("Username or Email is already taken!", Severity.Error);
            return;
        }
        var newUser = new CreateAccountModels
        {

            Firstname = CreateAccountCredentialsModel.FirstName,
            Lastname = CreateAccountCredentialsModel.LastName,
            Email = CreateAccountCredentialsModel.Email,
            Username = CreateAccountCredentialsModel.Username,
            Password = CreateAccountCredentialsModel.Password
        };


        var result = await loginClient.CreateUserAsync(newUser);

        if (result)
        {
            await ShowMessage("Account created successfully! Please login.", Severity.Success);

            showCreateAccount = false;
            CreateAccountModels = new CreateAccountModels();
        }
        else
        {
            await ShowMessage("Registration failed. Please try again.", Severity.Error);
        }

        StateHasChanged();
    }




}